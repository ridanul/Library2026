# Copy this file to Backend/.env and fill in values for email provider + JWT.
# Do NOT commit Backend/.env (it's listed in .gitignore).

# ---------------------------------------------------------------------------
# Option A (recommended): Brevo API
# ---------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=KiU Library

# ---------------------------------------------------------------------------
# Option B: SMTP relay (works with Brevo SMTP relay or any SMTP provider)
# Leave empty if using Brevo API above.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password_or_key
SMTP_FROM=verified-sender@example.com

# Optional: secret key for JWT (set in production)
SECRET_KEY=change-me-to-a-secure-random-value
